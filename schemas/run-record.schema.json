{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flowgate:schema:run-record:v1",
  "title": "FlowGate Model Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "episode_id",
    "model_role",
    "model_id",
    "prompt_version",
    "prompt_sha256",
    "witness_digest",
    "started_at",
    "finished_at",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "cost",
    "validation",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,96}$"
    },
    "model_role": {
      "enum": [
        "local",
        "remote"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prompt_version": {
      "enum": [
        "local_v1",
        "remote_v1",
        "remote_v2"
      ]
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "witness_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "pricing_snapshot"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "pricing_snapshot": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid",
        "binding_valid",
        "citation_valid",
        "errors"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "binding_valid": {
          "type": "boolean"
        },
        "citation_valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "output": {
      "$ref": "model-output.schema.json"
    }
  }
}
